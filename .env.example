DEBUG=True
SECRET_KEY=your-secret-key-here
DATABASE_URL=postgresql://username:password@host:port/database_name?sslmode=require
# Backend hostnames, comma-separated; do not include scheme or paths.
ALLOWED_HOSTS=docpoint-backend-1dzd.onrender.com,localhost,127.0.0.1
# Frontend origin: scheme-সহ লিখুন, trailing slash বা path দেবেন না।
# একাধিক origin হলে comma দিয়ে লিখুন। Production-এ hosting platform-এ একই মান সেট করুন।
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173


# Resend email API: verify your sender domain and use its sender address.
DEFAULT_FROM_EMAIL=DocPoint <onboarding@resend.dev>
RESEND_API_KEY=
# EMAIL_BACKEND=core.email_backend.ResendEmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
