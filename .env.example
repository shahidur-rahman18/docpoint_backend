DEBUG=True
SECRET_KEY=your-secret-key-here
DATABASE_URL=postgresql://username:password@host:port/database_name?sslmode=require
# Backend hostnames, comma-separated; do not include scheme or paths.
ALLOWED_HOSTS=docpoint-backend-1dzd.onrender.com,localhost,127.0.0.1
# Frontend origin: scheme-সহ লিখুন, trailing slash বা path দেবেন না।
# একাধিক origin হলে comma দিয়ে লিখুন। Production-এ hosting platform-এ একই মান সেট করুন।
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Demo seed accounts. Set passwords, then run `python manage.py seed_demo_data`.
# On Render, run `python manage.py seed_demo_data --allow-production` in the Shell.
DEMO_ADMIN_EMAIL=demo-admin@example.test
DEMO_ADMIN_PASSWORD=
DEMO_DOCTOR_EMAIL=demo-doctor@example.test
DEMO_DOCTOR_PASSWORD=
DEMO_PATIENT_EMAIL=demo-patient@example.test

# Cloudinary image storage (set these in the local .env/deployment environment).
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_SECURE=True

# Resend email API: verify your sender domain and use its sender address.
DEFAULT_FROM_EMAIL=DocPoint <onboarding@resend.dev>
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
RESEND_API_KEY=
# EMAIL_BACKEND=core.email_backend.ResendEmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
