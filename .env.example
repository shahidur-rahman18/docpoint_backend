DEBUG=True
SECRET_KEY=your-secret-key-here
DATABASE_URL=postgresql://username:password@host:port/database_name?sslmode=require
ALLOWED_HOSTS=* # ১. প্রডাকশন সার্ভারের হোস্ট বা ডোমেইন কনফিগারেশনের প্লেসহোল্ডার
# CORS: local Vite frontend-এর origin; frontend-এর port/domain বদলালে এখানে origin-টি বদলান।
# Production-এ hosting platform-এর environment variables-এ production frontend origin সেট করুন।
# একাধিক origin হলে comma দিয়ে লিখুন, যেমন http://localhost:5173,https://your-frontend-domain.com
CORS_ALLOWED_ORIGINS=http://localhost:5173
